# ============================================================
# DECISION TREE CLASSIFIER - CANCER DATASET
# 80% TRAINING AND 20% TESTING
# ============================================================

import pandas as pd
import numpy as np

from sklearn.model_selection import train_test_split
from sklearn.tree import DecisionTreeClassifier
from sklearn.metrics import accuracy_score, classification_report
from sklearn.metrics import confusion_matrix
from sklearn.preprocessing import LabelEncoder
from sklearn.tree import plot_tree

import matplotlib.pyplot as plt
import seaborn as sns

# 1. LOAD DATASET
df = pd.read_csv(
    '/kaggle/input/datasets/erdemtaha/cancer-data/Cancer_Data.csv'
)

# 2. DATA CLEANING
df.drop(columns=['id', 'Unnamed: 32'], errors='ignore', inplace=True)
df.drop_duplicates(inplace=True)
df.dropna(inplace=True)

# 3. ENCODE TARGET VARIABLE
le = LabelEncoder()
df['diagnosis'] = le.fit_transform(df['diagnosis'])

# B = 0, M = 1
print("Target Encoding:")
print(dict(zip(le.classes_, le.transform(le.classes_))))

# 4. SEPARATE FEATURES AND TARGET
X = df.drop('diagnosis', axis=1)
y = df['diagnosis']

# 5. DIVIDE DATA INTO 80/20
X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

# 6. DISPLAY TRAINING AND TESTING DATA
print("\n========== DATA SPLITTING ==========")

print("Total Dataset:", len(df))
print("Training Data (80%):", len(X_train))
print("Testing Data (20%):", len(X_test))

# 7. CREATE DECISION TREE MODEL
model = DecisionTreeClassifier(
    criterion='gini',
    max_depth=5,
    random_state=42
)

# 8. TRAIN MODEL USING 80% DATA
model.fit(X_train, y_train)

print("\nDecision Tree Model Trained Successfully!")

# 9. PREDICT ON 20% TEST DATA
y_pred = model.predict(X_test)

# 10. DISPLAY MODEL RESULTS
print("\n========== MODEL RESULTS ==========")

print("Training Accuracy:",
      round(model.score(X_train, y_train) * 100, 2), "%")

print("Testing Accuracy:",
      round(accuracy_score(y_test, y_pred) * 100, 2), "%")

print("\nClassification Report:")
print(classification_report(
    y_test,
    y_pred,
    target_names=le.classes_
))

# 11. CONFUSION MATRIX
cm = confusion_matrix(y_test, y_pred)

plt.figure(figsize=(7, 5))

sns.heatmap(
    cm,
    annot=True,
    fmt='d',
    cmap='Blues',
    xticklabels=le.classes_,
    yticklabels=le.classes_
)

plt.title('Decision Tree - Confusion Matrix')
plt.xlabel('Predicted Diagnosis')
plt.ylabel('Actual Diagnosis')
plt.show()

# 12. VISUALIZE DECISION TREE
plt.figure(figsize=(24, 12))

plot_tree(
    model,
    feature_names=X.columns,
    class_names=le.classes_,
    filled=True,
    rounded=True,
    fontsize=8
)

plt.title('Decision Tree Classifier')
plt.show()

# 13. FINAL SUMMARY
print("\n========== FINAL SUMMARY ==========")
print("Algorithm: Decision Tree Classifier")
print("Training Split: 80%")
print("Testing Split: 20%")
print("Training Samples:", len(X_train))
print("Testing Samples:", len(X_test))
print("Testing Accuracy:",
      round(accuracy_score(y_test, y_pred) * 100, 2), "%")

print("\nMODEL TRAINING COMPLETED SUCCESSFULLY!")




# ============================================================
# TEST DECISION TREE MODEL ON REMAINING 20% DATA
# ============================================================

from sklearn.metrics import (
    accuracy_score,
    classification_report,
    confusion_matrix,
    precision_score,
    recall_score,
    f1_score
)

import matplotlib.pyplot as plt
import seaborn as sns

# 1. PREDICT USING TEST DATA (20%)
y_pred = model.predict(X_test)

# 2. CALCULATE ACCURACY
accuracy = accuracy_score(y_test, y_pred)

print("=" * 60)
print("       DECISION TREE MODEL - TESTING RESULTS")
print("=" * 60)

print("\nTotal Testing Samples:", len(X_test))
print("Correct Predictions:", (y_test == y_pred).sum())
print("Incorrect Predictions:", (y_test != y_pred).sum())

print("\nModel Accuracy: {:.2f}%".format(accuracy * 100))

# 3. OTHER PERFORMANCE METRICS
print("\nPrecision: {:.2f}%".format(
    precision_score(y_test, y_pred) * 100
))

print("Recall: {:.2f}%".format(
    recall_score(y_test, y_pred) * 100
))

print("F1 Score: {:.2f}%".format(
    f1_score(y_test, y_pred) * 100
))

# 4. CLASSIFICATION REPORT
print("\nClassification Report:")
print(classification_report(
    y_test,
    y_pred,
    target_names=le.classes_
))

# 5. CONFUSION MATRIX
cm = confusion_matrix(y_test, y_pred)

plt.figure(figsize=(7, 5))

sns.heatmap(
    cm,
    annot=True,
    fmt='d',
    cmap='Blues',
    xticklabels=le.classes_,
    yticklabels=le.classes_
)

plt.title('Decision Tree - Testing Confusion Matrix')
plt.xlabel('Predicted Diagnosis')
plt.ylabel('Actual Diagnosis')
plt.show()

# 6. FINAL ACCURACY RESULT
print("\n" + "=" * 60)
print("FINAL TESTING ACCURACY: {:.2f}%".format(accuracy * 100))
print("=" * 60)




